{
  "name": "cmds-tailwind-styles",
  "version": "1.2.8",
  "description": "A tailwind preset of utilities for Copa Airlines design system",
  "main": "dist/cmds-tailwind-styles.js",
  "directories": {
    "lib": "lib"
  },
  "type": "module",
  "license": "ISC",
  "author": "cpatino@copaair.com",
  "keywords": [
    "Copa",
    "Airlines",
    "Design",
    "System",
    "Tailwind",
    "CSS"
  ],
  "repository": {
    "type": "git",
    "url": "https://cm-content-and-performance@dev.azure.com/cm-content-and-performance/cm-design-system/_git/cmds-tailwind-styles"
  },
  "scripts": {
    "test-v4": "npx @tailwindcss/cli -i ./test/v4/input.css -o ./test/v4/output.css --watch",
    "test": "vitest",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "prepare": "husky",
    "test:cov": "vitest run --coverage"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/cli": "^4.3.0",
    "@types/node": "^25.9.3",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "prettier": "^3.8.4",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=20.18.0"
  },
  "packageManager": "pnpm@10.4.1",
  "lint-staged": {
    "**/*.{js,ts}": [
      "eslint --fix"
    ],
    "**/*": "prettier --write --ignore-unknown"
  }
}
